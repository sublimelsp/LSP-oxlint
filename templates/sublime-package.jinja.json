{
  "contributions": {
    "settings": [
      {
        "file_patterns": [
          "/LSP-oxlint.sublime-settings"
        ],
        "schema": {
          "$id": "sublime://settings/LSP-oxlint",
          "definitions": {
            "PluginConfig": {
              "properties": {
                "settings": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {{ settings | indent(18) }}
                },
                "initialization_options": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "oxc.requireConfig": {
                      "type": "boolean",
                      "default": false,
                      "markdownDescription": "Start the language server only when a `.oxlintrc.json(c)` or `oxlint.config.(m)ts` file exists in the root of one of the workspace folders."
                    },
                    "oxc.path.tsgolint": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "default": null,
                      "markdownDescription": "Path to an Oxc tsgolint binary. Default: auto detection from `oxlint`."
                    },
                    "oxc.suppressProgramErrors": {
                      "type": "boolean",
                      "default": false,
                      "markdownDescription": "Suppress tsconfig errors from tsgolint and still lint files under partially-valid tsconfig projects. When enabled, sets `OXLINT_TSGOLINT_DANGEROUSLY_SUPPRESS_PROGRAM_DIAGNOSTICS=true`. **Note:** Type-aware lint rules may produce degraded results when the tsconfig is broken."
                    }
                  }
                },
                "server_path": {
                  "type": "string",
                  "default": "auto",
                  "markdownDescription": "The path to the `oxlint` binary used to start the language server. Use `auto` to use the project's `node_modules/oxlint` if present and otherwise the version managed by this package. A relative path is resolved against the workspace folder."
                }
              }
            }
          },
          "type": "object",
          "allOf": [
            {
              "$ref": "sublime://settings/LSP-plugin-base"
            },
            {
              "$ref": "sublime://settings/LSP-oxlint#/definitions/PluginConfig"
            }
          ]
        }
      },
      {
        "file_patterns": [
          "/*.sublime-project"
        ],
        "schema": {
          "properties": {
            "settings": {
              "properties": {
                "LSP": {
                  "properties": {
                    "LSP-oxlint": {
                      "$ref": "sublime://settings/LSP-oxlint#/definitions/PluginConfig"
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "file_patterns": [
          "LSP.sublime-settings"
        ],
        "schema": {
          "properties": {
            "lsp_code_actions_on_save": {
              "properties": {
                "source.fixAll.oxc": {
                  "type": "boolean"
                },
                "source.fixAllDangerous.oxc": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    ]
  }
}
