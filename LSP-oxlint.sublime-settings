{
	"settings": {
		// Run the linter on save (onSave) or on type (onType)
		"run": "onType",
		// Path to oxlint configuration. Keep it empty to enable nested configuration.
		"configPath": null,
		// Path to the project's TypeScript config file.
		//
		// If your `tsconfig.json` is not at the root, you will need this set for the `import` plugin rules to resolve imports correctly.
		"tsConfigPath": null,
		// Define how directive comments like `// oxlint-disable-line` should be reported, when no errors would have been reported on that line anyway. It is preferred to use `options.reportUnusedDisableDirectives` in your configuration file
		"unusedDisableDirectives": null,
		// Forces type-aware linting. Requires the `oxlint-tsgolint` package. It is preferred to use `options.typeAware` in your configuration file
		"typeAware": null,
		// Disable searching for nested configuration files. When set to true, only the configuration file specified in `configPath` (if any) will be used.
		"disableNestedConfig": false,
		// Specify the kind of fixes to suggest/apply.
		"fixKind": null,
		// Customizes linting rules behavior. See <https://oxc.rs/docs/guide/usage/linter/lsp-config-reference.html#rulescustomization> for details.
		"rulesCustomization": null,
	},
	// Options that apply when the server starts. Changing these restarts the server.
	"initialization_options": {
		// Start the language server only when a `.oxlintrc.json(c)` or `oxlint.config.(m)ts` file exists in the root
		// of one of the workspace folders.
		"oxc.requireConfig": false,
		// Path to an Oxc tsgolint binary. Default: auto detection from `oxlint`.
		"oxc.path.tsgolint": null,
		// Suppress tsconfig errors from tsgolint and still lint files under partially-valid tsconfig projects.
		// Type-aware lint rules may produce degraded results when the tsconfig is broken.
		"oxc.suppressProgramErrors": false,
	},
	"selector": "source.js | source.ts | source.jsx | source.tsx | source.js.jsx | source.js.react | source.ts.react | source.astro | text.html.astro | text.html.svelte | text.html.vue",
	// The path to the oxlint binary used to start the language server.
	// Use `auto` to use the project's `node_modules/oxlint` if present and otherwise the version managed by
	// this package.
	// If the path is relative, the workspace folder will be used as base path.
	// NOTE: Change this instead of directly updating `command` - the `${server_path}` variable is dynamically resolved
	// based on this setting.
	"server_path": "auto",
	"command": [
		"${node_bin}",
		"${server_path}",
		"--lsp"
	]
}
